# Admin dashboard (Vite). Copy to .env and fill in. Only VITE_* values are
# exposed to the browser — never put a secret here.

# Base URL of the backend API, baked into the bundle at BUILD time (set it
# before `npm run build`, rebuild after changing it). Required for any
# deployed build. When unset: the dev server uses <page host>:5000, and a
# production build calls /api on the same origin as the page (only works
# if a reverse proxy serves the backend under that same domain).
# VITE_API_URL=https://api.your-domain.com
