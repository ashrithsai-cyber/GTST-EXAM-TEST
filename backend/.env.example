# Copy to backend/.env and fill in. Never commit the real .env.
# Every value here is a placeholder — real keys live only in the
# deployment's secret store / the untracked backend/.env.

PORT=5000

# "production" in any deployed environment: disables the localhost/LAN
# dev-server CORS allowance (list real origins below). Use "development"
# for local testing against the Vite dev servers.
NODE_ENV=production

# Number of reverse proxies in front of the backend (Nginx, Render,
# Railway, a load balancer...). Needed so rate limiting sees the real
# client IP. Leave unset when the backend is reached directly.
# TRUST_PROXY=1

# Registration/payments Supabase project — read-only lookup of
# registrations at student login. Service-role key: backend only.
REGISTRATION_SUPABASE_URL=https://your-registration-project.supabase.co
REGISTRATION_SUPABASE_SERVICE_ROLE_KEY=

# Dedicated exam Supabase project (run backend/sql/*.sql against it, in
# order). Service-role key: backend only.
EXAM_SUPABASE_URL=https://your-exam-project.supabase.co
EXAM_SUPABASE_SERVICE_ROLE_KEY=

# Separate, long random secrets for student and admin tokens, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start if either is missing, shorter than 32
# characters, or if both are the same value.
STUDENT_JWT_SECRET=
STUDENT_JWT_EXPIRES_IN=4h
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=8h

# Comma-separated origins allowed by CORS: scheme + host (+ port), no path,
# no trailing slash. Never a wildcard. Both are REQUIRED in production —
# with NODE_ENV=production nothing else is allowed.
# The student portal on localhost/LAN port 5173 is always allowed in dev;
# for local development set ADMIN_ALLOWED_ORIGINS=http://localhost:5174.
#   ADMIN_ALLOWED_ORIGINS=https://admin.your-domain.com
#   STUDENT_ALLOWED_ORIGINS=https://exam.your-domain.com
ADMIN_ALLOWED_ORIGINS=
STUDENT_ALLOWED_ORIGINS=

# Only shown to students when the active exam has no exam_date set.
# EXAM_DATE=2026-10-11

# How long a completed System Check / rules acceptance stays valid for
# starting the exam (minutes). Default 720 (12h) covers an early check-in
# followed by the scheduled-start waiting room.
# PREFLIGHT_MAX_AGE_MINUTES=720
